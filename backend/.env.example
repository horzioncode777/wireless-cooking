PORT=6001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# En el servidor se puede servir también el frontend compilado.
SERVE_FRONTEND=false
# Solo para un proxy en la misma máquina, con el puerto del backend privado.
TRUST_PROXY=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=wireless_cooking
DB_USER=postgres
DB_PASSWORD=CAMBIAR
DB_SSL=false
# Ruta al certificado público de confianza de Amazon RDS al activar SSL.
DB_SSL_CA_FILE=
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES
PAYMENT_MODE=demo
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=test
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Límite persistente de consultas diarias de IA para toda la web (hora de Colombia).
# No representa un límite monetario de la cuenta de OpenAI.
CHAT_AI_DAILY_LIMIT=20
# Recuperación por código con Gmail (sin dominio propio).
# Usa una contraseña de aplicación de Google, nunca tu contraseña de acceso.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGE_STORAGE=local
